# ==========================================
# SwitchOps AI - Configuration
# ==========================================

# Port Configuration
PORT=3001
CLIENT_PORT=5173

# Switch AI Official Connection (Leave empty or set to 'simulator' to use local test adapter)
# When deploying to a real Switch instance, provide the Bridge URL and credentials:
# Example: http://localhost:8080 or https://bridge.switchagents.ai
SWITCH_BRIDGE_URL=
SWITCH_AGENT_ID=switchops-ai
SWITCH_API_KEY=
SWITCH_ROOM_IDS=incidents-ops,checkout-team

# Switch Registration Token (Optional: used to register new agent out-of-band)
SWITCH_REGISTRATION_TOKEN=

# AI Provider Configuration (Optional: uses high-fidelity Deterministic Planner if not set)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application Mode: 'demo' (deterministic simulation) or 'live'
APP_MODE=demo

# Database Path
SQLITE_DB_PATH=./data/switchops.db
